  "finding": {
    "id": "RV27-02",
    "severity": "P3",
    "blocking": false,
    "title": "Selected-covariance guard does not bound total numerical error in extreme near-null cases",
    "file": "src/scalable_gp.py",
    "line": 343,
    "end_line": 360,
    "trigger": "A=[[1,1],[1,1.0001]], N=1e-16 I, two host cells one arcsec apart, finite Matern scale 1.7 arcsec and amplitude 1. Selected covariance returns rather than raising.",
    "evidence": "Independent 90-digit Decimal information-form oracle: marginal-SD-product-scaled error 1.2214031646228625e-7; accepted observation solve residual 7.711660704942526e-12. An extreme scale=1e5 arcsec case reaches 9.52867542459389e-7.",
    "consequence": "The 1e-8 precision gate cannot be interpreted as a bound on total covariance accuracy. Returned variances remain positive and nonzero; these tiny errors do not reproduce the original catastrophic failure or justify blocking experimental progression.",
    "cause": "The bound covers residual formation and accumulation but does not fully propagate gain-solve and kernel/FFT errors.",
    "required_followup": "Track as a minor numerical follow-up. Strengthen the bound or explicitly refuse the unresolved near-null regimes. Add the two saved behavioral cases; require covariance error <=1e-8 versus an independent high-precision oracle or explicit NumericalFailure. Do not introduce floors, jitter, changed noise, or weakened existing gates.",
    "artifacts": [
      "adversarial.json",
      "broad-kernel.json"
    ],
    "performance_finding": false
  },
